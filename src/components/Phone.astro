---
// Captura dentro de un marco de móvil. Las capturas son de 540 px de ancho (2x para 270 px).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  width?: number; // ancho mostrado en px
  eager?: boolean; // true en la imagen principal de la portada (LCP)
  class?: string;
}

const { src, alt, width = 270, eager = false, class: className } = Astro.props;
---

<div class:list={['phone', className]} style={`--w: ${width}px`}>
  <Image
    src={src}
    alt={alt}
    widths={[width, width * 2].filter((w) => w <= src.width)}
    sizes={`${width}px`}
    format="webp"
    quality={82}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
  />
</div>

<style>
  .phone {
    width: min(var(--w), 100%);
    padding: 0.55rem;
    border-radius: 2.1rem;
    background: linear-gradient(160deg, #2a2f39, #13161c 40%, #0d0f13);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.08),
      0 30px 60px -20px rgb(0 0 0 / 0.8),
      0 0 0 1px rgb(0 0 0 / 0.6);
    position: relative;
  }

  .phone::before {
    content: '';
    position: absolute;
    top: 1.05rem;
    left: 50%;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: #05060a;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.08);
    transform: translateX(-50%);
    z-index: 1;
  }

  .phone img {
    width: 100%;
    border-radius: 1.6rem;
    background: #000;
  }
</style>
